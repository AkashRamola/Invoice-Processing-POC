@{
    ViewData["Title"] = "Register";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    html, body {
        height: 100%;
        margin: 0;
        overflow: hidden;
    }

    body {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #2563eb 100%);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .register-wrapper {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        box-sizing: border-box;
    }

    .register-card {
        width: 100%;
        max-width: 420px;
        max-height: 96vh;
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
        animation: fadeInUp 0.4s ease;
        display: flex;
        flex-direction: column;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .register-card .card-header {
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        color: #fff;
        border: none;
        padding: 1rem 1rem 0.85rem;
        text-align: center;
        flex-shrink: 0;
    }

        .register-card .card-header .icon-circle {
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.4rem;
            font-size: 1.1rem;
        }

        .register-card .card-header h3 {
            font-weight: 600;
            margin-bottom: 0.1rem;
            font-size: 1.15rem;
        }

        .register-card .card-header p {
            margin: 0;
            opacity: 0.85;
            font-size: 0.78rem;
        }

    .register-card .card-body {
        background: #fff;
        padding: 1rem 1.25rem 1.1rem;
        overflow-y: auto;
    }

    .form-label {
        font-weight: 500;
        color: #374151;
        font-size: 0.78rem;
        margin-bottom: 0.2rem;
    }

    .input-group-text {
        background: #f3f4f6;
        border-right: none;
        color: #6b7280;
        padding: 0.4rem 0.6rem;
        font-size: 0.85rem;
    }

    .form-control, .form-select {
        border-left: none;
        padding: 0.4rem 0.6rem;
        font-size: 0.85rem;
    }

    .form-select {
        border-left: 1px solid #ced4da;
    }

    .input-group:focus-within .input-group-text,
    .input-group:focus-within .form-control {
        border-color: #4f46e5;
    }

    .form-control:focus, .form-select:focus {
        box-shadow: none;
        border-color: #4f46e5;
    }

    .mb-compact {
        margin-bottom: 0.65rem;
    }

    .btn-register-submit {
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        border: none;
        padding: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
        border-radius: 7px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .btn-register-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(79, 70, 229, 0.35);
        }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #9ca3af;
        font-size: 0.72rem;
        margin: 0.7rem 0;
    }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid #e5e7eb;
        }

        .divider:not(:empty)::before {
            margin-right: .6em;
        }

        .divider:not(:empty)::after {
            margin-left: .6em;
        }

    .btn-login-link {
        border: 1.5px solid #4f46e5;
        color: #4f46e5;
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 7px;
        padding: 0.45rem;
        background: #fff;
        transition: background 0.15s ease, color 0.15s ease;
    }

        .btn-login-link:hover {
            background: #4f46e5;
            color: #fff;
        }

    #message {
        display: block;
        text-align: center;
        font-size: 0.8rem;
    }

    .invalid-feedback {
        font-size: 0.72rem;
    }
</style>

<div class="register-wrapper">
    <div class="card register-card">
        <div class="card-header">
            <div class="icon-circle">
                <i class="bi bi-person-plus"></i>
            </div>
            <h3>Create Account</h3>
            <p>Register to access the Invoice Portal</p>
        </div>
        <div class="card-body">

            <div class="mb-compact">
                <label class="form-label">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text"
                           id="txtName"
                           class="form-control"
                           placeholder="Enter Full Name" />
                </div>
                <div class="invalid-feedback" id="errName"></div>
            </div>

            <div class="mb-compact">
                <label class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-at"></i></span>
                    <input type="text"
                           id="txtUserName"
                           class="form-control"
                           placeholder="Choose a Username" />
                </div>
                <div class="invalid-feedback" id="errUserName"></div>
            </div>

            <div class="mb-compact">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password"
                           id="txtPassword"
                           class="form-control"
                           placeholder="Enter Password" />
                </div>
                <div class="invalid-feedback" id="errPassword"></div>
            </div>

            <div class="mb-compact">
                <label class="form-label">Role</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                    <select id="ddlRoleId" class="form-select">
                        <option value="">-- Select Role --</option>
                        <option value="1">Admin</option>
                        <option value="2">Approver</option>
                        <option value="3">Vendor</option>
                        <option value="4">Employee</option>
                    </select>
                </div>
                <div class="invalid-feedback" id="errRoleId"></div>
            </div>

            <div class="d-grid mt-2">
                <button id="btnRegister" class="btn btn-register-submit text-white">
                    <i class="bi bi-check-circle me-1"></i> Register
                </button>
            </div>

            <div class="divider">Already have an account?</div>

            <div class="d-grid">
                <a href="/Login/Index" class="btn btn-login-link">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Back to Login
                </a>
            </div>

            <div class="mt-2">
                <span id="message"></span>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function clearErrors() {
        $(".form-control, .form-select").removeClass("is-invalid");
        $(".invalid-feedback").text("");
    }

    function validateForm(data) {
        let isValid = true;
        clearErrors();

        if (!data.name) {
            $("#txtName").addClass("is-invalid");
            $("#errName").text("Name is required.");
            isValid = false;
        }
        if (!data.username) {
            $("#txtUserName").addClass("is-invalid");
            $("#errUserName").text("Username is required.");
            isValid = false;
        }
        if (!data.password) {
            $("#txtPassword").addClass("is-invalid");
            $("#errPassword").text("Password is required.");
            isValid = false;
        } else if (data.password.length < 6) {
            $("#txtPassword").addClass("is-invalid");
            $("#errPassword").text("Password must be at least 6 characters.");
            isValid = false;
        }
        if (!data.roleId) {
            $("#ddlRoleId").addClass("is-invalid");
            $("#errRoleId").text("Please select a role.");
            isValid = false;
        }

        return isValid;
    }

    $("#btnRegister").click(function () {
        var registerData = {
            name: $("#txtName").val().trim(),
            username: $("#txtUserName").val().trim(),
            password: $("#txtPassword").val(),
            roleId: $("#ddlRoleId").val()
        };

        if (!validateForm(registerData)) {
            return;
        }

        var btn = $(this);
        btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Registering...');

        $.ajax({
            url: '/Login/RegisterUser',
            type: 'POST',
            data: {
                name: registerData.name,
                username: registerData.username,
                password: registerData.password,
                roleId: registerData.roleId
            },
            success: function (response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Registered!',
                        text: response.message
                    }).then(() => {
                        window.location.href = '/Login/Index';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Registration Failed',
                        text: response.message
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Something went wrong. Please try again.'
                });
            },
            complete: function () {
                btn.prop("disabled", false).html('<i class="bi bi-check-circle me-1"></i> Register');
            }
        });
    });
</script>