@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    body {
        min-height: 100vh;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #2563eb 100%);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .login-wrapper {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(6px);
        animation: fadeInUp 0.5s ease;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .login-card .card-header {
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        color: #fff;
        border: none;
        padding: 2rem 1.5rem 1.5rem;
        text-align: center;
    }

    .login-card .card-header .icon-circle {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.75rem;
        font-size: 1.6rem;
    }

    .login-card .card-header h3 {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .login-card .card-header p {
        margin: 0;
        opacity: 0.85;
        font-size: 0.9rem;
    }

    .login-card .card-body {
        background: #fff;
        padding: 2rem 1.75rem;
    }

    .form-label {
        font-weight: 500;
        color: #374151;
        font-size: 0.9rem;
    }

    .input-group-text {
        background: #f3f4f6;
        border-right: none;
        color: #6b7280;
    }

    .form-control {
        border-left: none;
        padding: 0.65rem 0.75rem;
    }

    .input-group:focus-within .input-group-text,
    .input-group:focus-within .form-control {
        border-color: #4f46e5;
    }

    .form-control:focus {
        box-shadow: none;
        border-color: #4f46e5;
    }

    .btn-login {
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        border: none;
        padding: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        border-radius: 8px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-login:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.35);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #9ca3af;
        font-size: 0.8rem;
        margin: 1.25rem 0;
    }

    .divider::before,
    .divider::after {
        content: "";
        flex: 1;
        border-bottom: 1px solid #e5e7eb;
    }

    .divider:not(:empty)::before {
        margin-right: .75em;
    }

    .divider:not(:empty)::after {
        margin-left: .75em;
    }

    .btn-register {
        border: 1.5px solid #4f46e5;
        color: #4f46e5;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.6rem;
        background: #fff;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .btn-register:hover {
        background: #4f46e5;
        color: #fff;
    }

    #message {
        display: block;
        text-align: center;
        font-size: 0.9rem;
    }
</style>

<div class="login-wrapper">
    <div class="card login-card">
        <div class="card-header">
            <div class="icon-circle">
                <i class="bi bi-receipt"></i>
            </div>
            <h3>Invoice Processing Portal</h3>
            <p>Sign in to manage your invoices</p>
        </div>
        <div class="card-body">

            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email"
                           id="txtEmail"
                           class="form-control"
                           placeholder="Enter Email" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password"
                           id="txtPassword"
                           class="form-control"
                           placeholder="Enter Password" />
                </div>
            </div>

            <div class="d-flex justify-content-end mb-3">
                <a href="#" class="text-decoration-none small">Forgot password?</a>
            </div>

            <div class="d-grid">
                <button id="btnLogin" class="btn btn-login text-white">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                </button>
            </div>

            <div class="divider">New here?</div>

            <div class="d-grid">
                <a href="/Login/Register" class="btn btn-register">
                    <i class="bi bi-person-plus me-1"></i> Create an Account
                </a>
            </div>

            <div class="mt-3">
                <span id="message"></span>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $("#btnLogin").click(function () {
        var email = $("#txtEmail").val();
        var password = $("#txtPassword").val();
        if(email=='' || password=='')
        {
            Swal.fire({
                icon: 'error',
                title: 'Invalid',
                text: 'Email or Password value is null'
            });
            return;
        }
        $.ajax({
            url: '@Url.Action("LoginUser", "Login")',
            type: 'POST',
            data: {
                Username: email,
                Password: password 
            },
            success: function (response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.data.email
                    }).then(() => {
                        window.location.href = '@Url.Action("Index", "UploadFile")';
                    });
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Login Failed',
                        text: response.message
                    }).then(() => {
                        window.location.href = '@Url.Action("Index", "Login")';
                    });
                }
            },
            error: function (xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Server Error',
                    text: 'Something went wrong. Please try again later.'
                });
            }
        });
    });
</script>