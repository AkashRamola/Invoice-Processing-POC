@{
    ViewData["Title"] = "PDF Upload";
    Layout = null;
}

@model IEnumerable<DTO.Data.UploadDocumentDTO>


<div>
    <div>
        <div>

        </div>
        <div>

        </div>
    </div>
    <div>
        <table>
            <thead>
                <tr>
                    <th>Sr. No.</th>
                    <th>File Name</th>
                    <th>Upload Date</th>
                    <th>Extracted Text</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int serialNumber = 1;
                    foreach (var file in Model)
                    {
                        <tr>
                            <td>@serialNumber</td>
                            <td>@file.FileName</td>
                            <td>@file.UploadDate.ToString("dd/MM/yyyy")</td>
                            <td>@file.ExtractedInfo</td>
                        </tr>
                        serialNumber++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">No files uploaded yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>